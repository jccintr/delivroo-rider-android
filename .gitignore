# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Firebase — chave de conta de serviço (usada pela EAS pra enviar push via
# FCM v1). Nunca comitar isso — sobe direto pra EAS via `eas credentials`.
# google-services.json (o outro arquivo do Firebase) é seguro comitar e
# fica de fora dessa regra de propósito — só tem IDs públicos do projeto.
*firebase-adminsdk*.json
*service-account*.json


